{
    "name": "pne-ui",
    "version": "5.0.0-rc.43",
    "description": "React component kit on MUI for Payneteasy applications",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/alcovp/pne-ui.git"
    },
    "main": "cjs/index.js",
    "module": "esm/index.js",
    "types": "./esm/index.d.ts",
    "exports": {
        ".": {
            "types": "./esm/index.d.ts",
            "import": "./esm/index.js",
            "require": "./cjs/index.js",
            "default": "./esm/index.js"
        },
        "./fonts.css": "./fonts/pne-fonts.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rm -rf cjs esm",
        "build": "yarn clean && yarn build:esm && yarn build:cjs",
        "tsc": "node node_modules/typescript-7/bin/tsc",
        "build:esm": "yarn tsc",
        "build:cjs": "yarn tsc -p tsconfig.cjs.json",
        "lint": "eslint \"{**/*,*}.{js,mjs,ts,jsx,tsx}\"",
        "test": "jest --config jestconfig.json --maxWorkers=2",
        "typecheck:api": "yarn tsc -p tsconfig.type-tests.json --pretty false",
        "check": "yarn build && yarn check:built",
        "npmLogin": "npm login --registry=https://registry.npmjs.org/",
        "version:patch": "npm version patch --no-git-tag-version",
        "version:minor": "npm version minor --no-git-tag-version",
        "version:major": "npm version major --no-git-tag-version",
        "version:rc:patch": "npm version prepatch --preid=rc --no-git-tag-version",
        "version:rc:minor": "npm version preminor --preid=rc --no-git-tag-version",
        "version:rc:major": "npm version premajor --preid=rc --no-git-tag-version",
        "version:rc:next": "npm version prerelease --preid=rc --no-git-tag-version",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "storybook:check": "node scripts/storybook-check.mjs",
        "usage:map": "node scripts/usage-map.mjs",
        "typecheck:contracts": "yarn tsc --project tsconfig.contracts.json",
        "typecheck:stories": "yarn tsc --project tsconfig.stories.json",
        "typecheck:tests": "yarn tsc --project tsconfig.test.json",
        "check:built": "yarn typecheck:api && yarn test && yarn test:release && yarn lint && yarn typecheck:contracts && yarn typecheck:stories && yarn typecheck:tests",
        "test:release": "node --test test-release/*.test.mjs",
        "release:prepare": "node scripts/release.mjs prepare",
        "release:send": "node scripts/release.mjs send",
        "release:status": "node scripts/release.mjs status",
        "release:check": "yarn check && node scripts/release-ci.mjs pack",
        "audit:package": "yarn npm audit --recursive --environment production",
        "audit:tools": "yarn npm audit --all --recursive --severity high --no-deprecations"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "keywords": [
        "react",
        "typescript",
        "ui",
        "mui"
    ],
    "files": [
        "cjs",
        "esm",
        "docs",
        "fonts",
        "README.md",
        "LICENSE"
    ],
    "author": {
        "name": "Payneteasy"
    },
    "license": "MIT",
    "peerDependencies": {
        "@emotion/react": "^11",
        "@emotion/styled": "^11",
        "@mui/icons-material": ">=9.0.1 <10",
        "@mui/material": ">=9.0.1 <10",
        "@mui/system": ">=9.0.1 <10",
        "@mui/x-date-pickers": "^9",
        "@mui/x-date-pickers-pro": "^9",
        "dayjs": "^1.11.10",
        "i18next": ">=21 <26",
        "react": "^19",
        "react-dom": "^19",
        "react-i18next": ">=11 <17"
    },
    "devDependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@eslint-react/eslint-plugin": "5.30.2",
        "@eslint/js": "10.0.1",
        "@mui/icons-material": "9.0.1",
        "@mui/material": "9.0.1",
        "@mui/system": "9.0.1",
        "@mui/x-date-pickers": "9.0.4",
        "@mui/x-date-pickers-pro": "9.0.4",
        "@storybook/addon-docs": "10.6.7",
        "@storybook/addon-links": "10.6.7",
        "@storybook/addon-webpack5-compiler-swc": "4.0.3",
        "@storybook/react": "10.6.7",
        "@storybook/react-webpack5": "10.6.7",
        "@stylistic/eslint-plugin": "5.10.0",
        "@swc/core": "1.16.22",
        "@swc/jest": "0.2.39",
        "@testing-library/dom": "10.4.1",
        "@testing-library/react": "16.3.2",
        "@types/jest": "30.0.0",
        "@types/lodash": "4.17.13",
        "@types/node": "24.19.2",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@typescript-eslint/eslint-plugin": "8.72.2",
        "@typescript-eslint/parser": "8.72.2",
        "dayjs": "1.11.20",
        "eslint": "10.14.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-storybook": "10.6.7",
        "globals": "17.14.0",
        "i18next": "23.10.0",
        "jest": "30.5.2",
        "jest-canvas-mock": "2.5.8",
        "jest-environment-jsdom": "30.5.2",
        "playwright-core": "1.65.0",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-i18next": "11.18.6",
        "storybook": "10.6.7",
        "typescript": "6.0.3",
        "typescript-7": "npm:typescript@7.0.2"
    },
    "dependencies": {
        "@hello-pangea/dnd": "^18.0.1",
        "immer": "^10.0.3",
        "lodash": "^4.17.21",
        "react-imask": "^7.6.1",
        "react-virtuoso": "^4.7.5",
        "tslib": "^2.8.1",
        "zustand": "^5.0.0"
    },
    "bugs": {
        "url": "https://github.com/alcovp/pne-ui/issues"
    },
    "homepage": "https://github.com/alcovp/pne-ui#readme",
    "packageManager": "yarn@4.18.1"
}
