{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": false,
        "noEmit": true,
        "rootDir": ".",
        "sourceMap": false
    },
    "include": [
        "src/**/*.d.ts",
        "type-tests/**/*.ts",
        "type-tests/**/*.tsx"
    ],
    "exclude": [
        "cjs",
        "esm",
        "node_modules"
    ]
}
