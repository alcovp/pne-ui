{
    "transform": {
        "^.+\\.tsx$": ["@swc/jest", {
            "swcrc": false,
            "jsc": {
                "parser": {"syntax": "typescript", "tsx": true},
                "transform": {"react": {"runtime": "classic"}},
                "target": "es2022"
            }
        }],
        "^.+\\.ts$": ["@swc/jest", {
            "swcrc": false,
            "jsc": {
                "parser": {"syntax": "typescript"},
                "target": "es2022"
            }
        }]
    },
    "testRegex": "(/test/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "moduleFileExtensions": [
        "ts",
        "tsx",
        "js",
        "jsx",
        "json",
        "node"
    ],
    "testEnvironment": "jsdom",
    "testTimeout": 20000
}
