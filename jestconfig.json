{
    "transform": {
        "^.+\\.(t|j)sx?$": ["ts-jest", {"tsconfig": "tsconfig.test.json"}]
    },
    "testRegex": "(/test/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "moduleFileExtensions": [
        "ts",
        "tsx",
        "js",
        "jsx",
        "json",
        "node"
    ],
    "testEnvironment": "jsdom",
    "testTimeout": 20000
}
